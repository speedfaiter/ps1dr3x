# Copy this file to .env and fill in your key.
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the default model.
# VIDEO_AGENT_MODEL=claude-opus-5-5

# Optional: Whisper model size for auto-subtitles (tiny|base|small|medium|large-v3).
# VIDEO_AGENT_WHISPER_MODEL=small

# Optional: extra ffmpeg flags appended to the render command.
# VIDEO_AGENT_FFMPEG_EXTRA=
